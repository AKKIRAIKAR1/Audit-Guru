DATABASE_URL=sqlite:///./data/ocr.db
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/objects
SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
REDIS_URL=redis://localhost:6379/0
OCR_PROVIDER=tesseract
OCR_FALLBACK=tesseract
OCR_LANGUAGE=eng
PADDLE_LANGUAGE=en
MAX_FILE_MB=10
MAX_PAGES=50
MAX_IMAGE_PIXELS=25000000
OCR_TIMEOUT_SECONDS=90
JOB_LEASE_SECONDS=900
MAX_ATTEMPTS=3
QUALITY_CONFIDENCE_THRESHOLD=0.7
BLUR_THRESHOLD=60
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=local-minio
S3_SECRET_KEY=replace-local-minio-password
S3_BUCKET=invoices
S3_REGION=us-east-1
# Set AES256 for AWS S3 encryption, or aws:kms with configured KMS permissions.
S3_SERVER_SIDE_ENCRYPTION=
# Optional ClamAV INSTREAM service; when enabled, upload fails closed.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Administrator login. Password is stored as a salted hash.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD_HASH='pbkdf2_sha256$600000$747a2857a052e2bea93d9942dd04a2ff$387d13e2c36101c046d26a908d470a132f966378498ef4545c200ed899ec2261'
ADMIN_ORGANIZATION=demo-organization
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false
# Optional machine-to-machine keys; disabled by default.
API_KEYS={}
